generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

enum RecoveryStatus {
  OPEN
  AI_PROCESSING 
  PENDING_HUMAN_REVIEW
  AUTO_RECOVERED
  BLOCKED
  FAILED
}

model RecoveryCase{
  id                  Int             @id @default(autoincrement())
  paymentId           String          @unique //Razorpay id we will try to recover
  webhookEventId      Int             @unique //link to trigger event
  status              RecoveryStatus  @default(OPEN)
  liveState           String          //The state razorpay will return
  aiDiagnosis         String?         // Filled by AI Analyst later
  aiAction            String?         // Filled by AI Analyst later
  policyDecision      String?         // Filled by Policy Engine later
  ceratedAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  webhookEvent        WebhookEvent @relation(fields: [webhookEventId], references: [id])
}


model WebhookEvent {
  id          Int                @id @default(autoincrement())
  eventId     String             @unique
  eventType   String
  payload     Json
  status      WebhookEventStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  processedAt DateTime?

  recoveryCases         RecoveryCase[]
}

enum WebhookEventStatus {
  PENDING
  PROCESSED
  IGNORED
  FAILED
}


